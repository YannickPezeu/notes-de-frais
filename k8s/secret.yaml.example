# Copier en k8s/secret.yaml (ignoré par git) et remplir. update.ps1 l'applique s'il existe.
apiVersion: v1
kind: Secret
metadata:
  name: notes-de-frais-secrets
  namespace: epfl-chatbot
type: Opaque
stringData:
  # Clé d'application RCP utilisée côté serveur pour /extract.
  RCP_API_KEY: "REPLACE_ME"
  # Mot de passe de la page d'installation ; le changer invalide tous les favoris. Vide = accès libre.
  ACCESS_PASSWORD: "REPLACE_ME"
  # Signature des cookies de session (connexion EPFL), 32 caractères au moins :
  #   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
  SESSION_SECRET: "REPLACE_ME"
  # Secret client de l'application Entra (App Portal EPFL).
  ENTRA_CLIENT_SECRET: "REPLACE_ME"
  # Clé des empreintes de comptage (/stats), 32 caractères au moins ; ne jamais la changer.
  STATS_SECRET: "REPLACE_ME"
